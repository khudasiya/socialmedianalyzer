# ContentLens AI - Environment Configuration

# Server Port
PORT=5000

# AI Integration (Optional)
# Enter your Gemini API key below to enable real-time generative AI re-writes and advanced analysis.
# If left blank, ContentLens AI seamlessly operates using its built-in rule-based NLP engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API Endpoint
VITE_API_URL=http://localhost:5000/api
